meta {
  name: Consultar el historial mensual de uso
  type: http
  seq: 4
}

get {
  url: {{base_url}}/usage/history
  body: none
  auth: inherit
}

params:query {
  ~months: 6
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el uso mensual de validaciones, del más reciente al más antiguo.

  Parámetros de consulta:
  - `months` (opcional): Número de meses que incluye el historial (contados hacia atrás desde el momento de la consulta).

  Referencia: https://docs.veriko.mx/es/v1/usage/get-usage-history
  Guía: https://docs.veriko.mx/es/how-to/monitor-usage
}
