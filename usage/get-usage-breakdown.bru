meta {
  name: Desglosar el uso por operación
  type: http
  seq: 3
}

get {
  url: {{base_url}}/usage/breakdown
  body: none
  auth: inherit
}

params:query {
  ~period: current
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Desglosa el uso de un periodo por operación facturable.

  Parámetros de consulta:
  - `period` (opcional): Periodo a desglosar.

  Referencia: https://docs.veriko.mx/es/v1/usage/get-usage-breakdown
  Guía: https://docs.veriko.mx/es/how-to/monitor-usage
}
