meta {
  name: Exportar el uso de la API
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/usage/export?format=csv
  body: none
  auth: inherit
}

params:query {
  format: csv
  ~limit: 1
  ~from: 2026-04-01
  ~to: 2026-04-30
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga el registro de actividad de la API en CSV o XLSX, hasta 100,000 filas.

  Parámetros de consulta:
  - `format` (opcional): Formato del archivo que se descarga.
  - `limit` (opcional): Tope de filas de la descarga.
  - `from` (opcional): Fecha de inicio (inclusive) del rango a exportar, en formato ISO 8601 (YYYY-MM-DD).
  - `to` (opcional): Fecha de fin (inclusive) del rango a exportar, en formato ISO 8601 (YYYY-MM-DD).

  Referencia: https://docs.veriko.mx/es/v1/usage/export-api-usage
  Guía: https://docs.veriko.mx/es/how-to/monitor-usage
}
