meta {
  name: Consultar el uso de la API
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/usage
  body: none
  auth: inherit
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el uso de la API de la cuenta: peticiones de hoy y del mes, cuota, peticiones recientes y estado de Banxico.

  Referencia: https://docs.veriko.mx/es/v1/usage/get-api-usage
