meta {
  name: Consultar el mapa de calor del uso
  type: http
  seq: 6
}

get {
  url: {{base_url}}/usage/heatmap
  body: none
  auth: inherit
}

params:query {
  ~days: 30
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve las validaciones agrupadas por día de la semana y hora del día.

  Parámetros de consulta:
  - `days` (opcional): Número de días que incluye el mapa de calor.

  Referencia: https://docs.veriko.mx/es/v1/usage/get-usage-heatmap
  Guía: https://docs.veriko.mx/es/how-to/monitor-usage
}
