meta {
  name: Consultar el calendario SPEI
  type: http
  seq: 3
}

get {
  url: {{base_url}}/public/spei-calendar/2026
  body: none
  auth: none
}

headers {
  ~If-None-Match: {{calendar_etag}}
}

script:post-response {
  const etag = res.getHeader("etag");
  if (etag) {
    bru.setVar("calendar_etag", etag);
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve los días inhábiles de SPEI de un año y la disposición oficial de la que provienen.

  Guarda `calendar_etag`.

  Referencia: https://docs.veriko.mx/es/v1/public/get-spei-calendar
  Guía: https://docs.veriko.mx/es/concepts/timezone-handling
}
