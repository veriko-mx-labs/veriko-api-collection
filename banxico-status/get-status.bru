meta {
  name: Consultar el estado de Banxico
  type: http
  seq: 1
}

get {
  url: {{base_url}}/status/banxico
  body: none
  auth: inherit
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el estado operativo del servicio de validación de Banxico: `operational`, `degraded` o `down`.

  Referencia: https://docs.veriko.mx/es/v1/banxico-status/banxico-public-status
}
