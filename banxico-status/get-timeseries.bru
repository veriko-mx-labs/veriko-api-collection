meta {
  name: Consultar la serie de salud de Banxico
  type: http
  seq: 2
}

get {
  url: {{base_url}}/status/banxico/timeseries?metric=probe_latency&window=24h
  body: none
  auth: inherit
}

params:query {
  metric: probe_latency
  window: 24h
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el historial de salud del servicio de Banxico, agrupado por minuto o por hora.

  Parámetros de consulta:
  - `metric` (opcional): Filtro: serie que se devuelve.
  - `window` (opcional): Filtro: ventana que cubre la serie: `1h`, `8h`, `12h`, `24h` y `7d`.

  Referencia: https://docs.veriko.mx/es/v1/banxico-status/banxico-public-timeseries
}
