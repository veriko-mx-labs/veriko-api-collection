meta {
  name: Actualizar mi política de reintentos (destructiva)
  type: http
  seq: 3
  tags: [
    destructive
  ]
}

put {
  url: {{base_url}}/users/me/retry-policy
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "retry_policy": {
      "enabled": true,
      "max_retries": 3,
      "interval_seconds": 600,
      "outcomes": [
        "not_found",
        "cep_unavailable"
      ]
    }
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Define la política de reintentos predeterminada para las validaciones futuras.

  Petición destructiva. Cambia la configuración de la cuenta. Un valor que rebasa un tope se rechaza con `422 retry_policy_invalid`.

  Referencia: https://docs.veriko.mx/es/v1/users/update-my-retry-policy
  Guía: https://docs.veriko.mx/es/how-to/configure-retry-policy
}
