meta {
  name: Consultar mi política de reintentos
  type: http
  seq: 2
}

get {
  url: {{base_url}}/users/me/retry-policy
  body: none
  auth: inherit
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve la política de reintentos que aplica a cada validación que no trae su propio `retry_policy`.

  Referencia: https://docs.veriko.mx/es/v1/users/get-my-retry-policy
  Guía: https://docs.veriko.mx/es/how-to/configure-retry-policy
}
