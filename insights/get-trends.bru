meta {
  name: Consultar las tendencias
  type: http
  seq: 2
}

get {
  url: {{base_url}}/insights/trends
  body: none
  auth: inherit
}

params:query {
  ~range: 7d
  ~metric: volume
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve una serie de tiempo de las validaciones de la cuenta.

  Parámetros de consulta:
  - `range` (opcional): Filtro: ventana de tiempo que cubre la serie: `24h` (últimas 24 horas), `7d` (últimos 7 días), `30d` (últimos 30 días) o `90d` (últimos 90 días).
  - `metric` (opcional): Filtro: serie que se devuelve.

  Referencia: https://docs.veriko.mx/es/v1/insights/get-user-insights-trends
  Guía: https://docs.veriko.mx/es/how-to/analyze-insights
}
