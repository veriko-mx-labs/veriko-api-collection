meta {
  name: Listar los bancos principales
  type: http
  seq: 3
}

get {
  url: {{base_url}}/insights/top-banks
  body: none
  auth: inherit
}

params:query {
  ~metric: volume
  ~limit: 10
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lista los bancos de los últimos 30 días, ordenados por volumen o por tasa de error.

  Parámetros de consulta:
  - `metric` (opcional): Filtro: criterio de orden.
  - `limit` (opcional): Filtro: número máximo de bancos que se devuelven.

  Referencia: https://docs.veriko.mx/es/v1/insights/get-user-insights-top-banks
  Guía: https://docs.veriko.mx/es/how-to/analyze-insights
}
