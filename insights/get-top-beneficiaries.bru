meta {
  name: Listar los beneficiarios principales
  type: http
  seq: 4
}

get {
  url: {{base_url}}/insights/top-beneficiaries
  body: none
  auth: inherit
}

params:query {
  ~limit: 10
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lista los beneficiarios que más se detectaron en los últimos 90 días.

  Parámetros de consulta:
  - `limit` (opcional): Filtro: número máximo de beneficiarios que se devuelven.

  Referencia: https://docs.veriko.mx/es/v1/insights/get-user-insights-top-beneficiaries
  Guía: https://docs.veriko.mx/es/how-to/analyze-insights
}
