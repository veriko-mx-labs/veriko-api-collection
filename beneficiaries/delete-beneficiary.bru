meta {
  name: Archivar un beneficiario (destructiva)
  type: http
  seq: 7
  tags: [
    destructive
  ]
}

delete {
  url: {{base_url}}/beneficiaries/{{beneficiary_id}}
  body: none
  auth: inherit
}

tests {
  test("responde 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Archiva la cuenta de un beneficiario.

  Petición destructiva. La cuenta sale de la lista activa; el historial de validaciones se conserva. Registrar el mismo número otra vez la reactiva.

  Usa `beneficiary_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/delete-beneficiary
  Guía: https://docs.veriko.mx/es/how-to/manage-beneficiaries
}
