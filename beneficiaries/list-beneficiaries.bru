meta {
  name: Listar beneficiarios
  type: http
  seq: 1
}

get {
  url: {{base_url}}/beneficiaries
  body: none
  auth: inherit
}

params:query {
  ~with_archived: 0
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lista las cuentas de beneficiarios guardadas: CLABE, tarjeta y celular (DiMo). La lista no va paginada.

  Parámetros de consulta:
  - `with_archived` (opcional): Filtro de archivados: vacío u omitido = todas; `0` = sólo activas; `1` = sólo archivadas.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/list-beneficiaries
  Guía: https://docs.veriko.mx/es/how-to/manage-beneficiaries
}
