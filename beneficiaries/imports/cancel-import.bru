meta {
  name: Cancelar una importación (destructiva)
  type: http
  seq: 8
  tags: [
    destructive
  ]
}

delete {
  url: {{base_url}}/beneficiaries/imports/{{import_id}}
  body: none
  auth: inherit
}

tests {
  test("responde 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Cancela un trabajo de importación que aún no se confirmó.

  Petición destructiva. Aplica a los trabajos en `pending`, `parsing` y `preview_ready`. Los que están en un estado terminal responden `404`.

  Usa `import_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/cancel-beneficiary-import
  Guía: https://docs.veriko.mx/es/how-to/beneficiary-import
}
