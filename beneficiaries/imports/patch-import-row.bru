meta {
  name: Editar una fila de la vista previa (destructiva)
  type: http
  seq: 5
  tags: [
    destructive
  ]
}

patch {
  url: {{base_url}}/beneficiaries/imports/{{import_id}}/rows/{{import_row_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "parsed_label": "Proveedor de ejemplo",
    "parsed_account_type": "clabe"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Corrige una fila de la vista previa antes de confirmar la importación.

  Petición destructiva. Sobrescribe los campos que envíes y vuelve a procesar la fila.

  Usa `import_id` e `import_row_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define las variables en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/patch-beneficiary-import-row
  Guía: https://docs.veriko.mx/es/how-to/beneficiary-import
}
