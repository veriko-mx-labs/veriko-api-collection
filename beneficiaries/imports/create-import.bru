meta {
  name: Iniciar una importación
  type: http
  seq: 2
}

post {
  url: {{base_url}}/beneficiaries/imports
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(samples/beneficiaries.csv) @contentType(text/csv)
  parse_mode: template
}

script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("import_id", res.body.data.id);
  }
}

tests {
  test("abre el trabajo de importación", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.body.data.id).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Sube un archivo y abre un trabajo de importación. La lectura del archivo corre en segundo plano.

  Acepta CSV, XLS, XLSX, TXT, JSON o PDF de hasta 20 MB. Esta petición envía `samples/beneficiaries.csv`.

  Guarda `import_id`.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/create-beneficiary-import
  Guía: https://docs.veriko.mx/es/how-to/beneficiary-import
}
