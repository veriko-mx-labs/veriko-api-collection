meta {
  name: Consultar el estado de la importación
  type: http
  seq: 3
}

get {
  url: {{base_url}}/beneficiaries/imports/{{import_id}}
  body: none
  auth: inherit
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el estado y los contadores de un trabajo de importación.

  Sondea cada 2 segundos, más o menos, hasta que `status` sea `preview_ready`, `completed`, `failed` o `cancelled`.

  Usa `import_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/get-beneficiary-import
  Guía: https://docs.veriko.mx/es/how-to/beneficiary-import
}
