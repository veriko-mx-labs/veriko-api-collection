meta {
  name: Quitar una fila de la vista previa (destructiva)
  type: http
  seq: 6
  tags: [
    destructive
  ]
}

delete {
  url: {{base_url}}/beneficiaries/imports/{{import_id}}/rows/{{import_row_id}}
  body: none
  auth: inherit
}

tests {
  test("responde 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Quita una fila de un trabajo de importación antes de confirmarlo.

  Petición destructiva. Sólo la aceptan los trabajos en `preview_ready`; en los demás estados responde `422 job_not_editable`.

  Usa `import_id` e `import_row_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define las variables en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/delete-beneficiary-import-row
  Guía: https://docs.veriko.mx/es/how-to/beneficiary-import
}
