meta {
  name: Descargar la plantilla de importación
  type: http
  seq: 1
}

get {
  url: {{base_url}}/beneficiaries/imports/template?format=csv
  body: none
  auth: inherit
}

params:query {
  format: csv
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve la plantilla de importación con los encabezados fijos `alias`, `cuenta` y `banco` y filas de ejemplo.

  Parámetros de consulta:
  - `format` (obligatorio): Formato de la plantilla que se descarga.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/download-beneficiary-import-template
  Guía: https://docs.veriko.mx/es/how-to/beneficiary-import
}
