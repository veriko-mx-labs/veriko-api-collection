meta {
  name: Download the import template
  type: http
  seq: 1
}

get {
  url: {{base_url}}/beneficiaries/imports/template?format=csv
  body: none
  auth: inherit
}

params:query {
  format: csv
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns the import template with the fixed headers `alias`, `cuenta` and `banco` and example rows.

  Query parameters:
  - `format` (required): Format of the downloaded template.

  Reference: https://docs.veriko.mx/en/v1/beneficiaries/download-beneficiary-import-template
  Guide: https://docs.veriko.mx/en/how-to/beneficiary-import
}
