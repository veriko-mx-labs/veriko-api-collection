meta {
  name: Crear un beneficiario
  type: http
  seq: 2
}

post {
  url: {{base_url}}/beneficiaries
  body: json
  auth: inherit
}

body:json {
  {
    "account_number": "012180004412345678",
    "label": "Proveedor de ejemplo"
  }
}

script:post-response {
  if ([200, 201].includes(res.getStatus())) {
    bru.setVar("beneficiary_id", res.body.data.id);
  }
}

tests {
  test("registra el beneficiario", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.body.data.id).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Registra la cuenta de un beneficiario. El tipo se detecta por la longitud del número.

  Un celular (10 dígitos) necesita `bank_code`. Registrar una cuenta archivada la reactiva y responde `200`.

  Guarda `beneficiary_id`.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/create-beneficiary
  Guía: https://docs.veriko.mx/es/how-to/manage-beneficiaries
}
