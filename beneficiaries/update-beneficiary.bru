meta {
  name: Actualizar un beneficiario (destructiva)
  type: http
  seq: 3
  tags: [
    destructive
  ]
}

put {
  url: {{base_url}}/beneficiaries/{{beneficiary_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "label": "Proveedor de ejemplo (actualizado)"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Actualiza la etiqueta, el número de cuenta o la clave de banco de un beneficiario.

  Petición destructiva. Un `account_number` nuevo reemplaza la cuenta y vuelve a derivar el banco.

  Usa `beneficiary_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/update-beneficiary
  Guía: https://docs.veriko.mx/es/how-to/manage-beneficiaries
}
