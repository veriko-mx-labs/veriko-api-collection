meta {
  name: Update a beneficiary (destructive)
  type: http
  seq: 3
  tags: [
    destructive
  ]
}

put {
  url: {{base_url}}/beneficiaries/{{beneficiary_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "label": "Example supplier (updated)"
  }
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Updates the label, the account number or the bank code of a beneficiary.

  Destructive request. A new `account_number` replaces the account and derives the bank again.

  Uses `beneficiary_id`, saved by an earlier request. Run the requests in the order of the folder, or set the variable in the environment.

  Reference: https://docs.veriko.mx/en/v1/beneficiaries/update-beneficiary
  Guide: https://docs.veriko.mx/en/how-to/manage-beneficiaries
}
