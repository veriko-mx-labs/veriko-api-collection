meta {
  name: Exportar beneficiarios
  type: http
  seq: 6
}

get {
  url: {{base_url}}/beneficiaries/export?format=csv
  body: none
  auth: inherit
}

params:query {
  format: csv
  ~with_archived: 0
  ~limit: 1
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga los beneficiarios en CSV o XLSX, hasta 100,000 filas.

  Los números de cuenta salen enmascarados, salvo la CLABE.

  Parámetros de consulta:
  - `with_archived` (opcional): Filtro de archivados: vacío u omitido = todas; `0` = sólo activas; `1` = sólo archivadas.
  - `format` (opcional): Formato del archivo.
  - `limit` (opcional): Recorta el número de filas del archivo.

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/export-beneficiaries
  Guía: https://docs.veriko.mx/es/how-to/manage-beneficiaries
}
