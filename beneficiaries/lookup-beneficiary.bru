meta {
  name: Buscar una cuenta en tus beneficiarios
  type: http
  seq: 5
}

get {
  url: {{base_url}}/beneficiaries/lookup?account=012180004412345678
  body: none
  auth: inherit
}

params:query {
  account: 012180004412345678
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Busca un número de cuenta exacto entre los beneficiarios de la cuenta.

  Responde `404` cuando el número no está en tu lista.

  Parámetros de consulta:
  - `account` (obligatorio): Número de cuenta completo: 10 dígitos (celular), 16 (tarjeta) o 18 (CLABE).

  Referencia: https://docs.veriko.mx/es/v1/beneficiaries/lookup-beneficiary-account
  Guía: https://docs.veriko.mx/es/how-to/manage-beneficiaries
}
