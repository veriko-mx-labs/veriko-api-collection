meta {
  name: Enviar un evento de prueba
  type: http
  seq: 4
}

post {
  url: {{base_url}}/webhooks/{{webhook_id}}/test
  body: none
  auth: inherit
}

tests {
  test("el receptor respondió con un estado 2xx", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.attributes.delivered, res.body.data.attributes.error || "el receptor no respondió 2xx").to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Envía una entrega sintética al endpoint e informa cómo respondió el receptor.

  La respuesta es `200` aunque el receptor falle. La prueba revisa `delivered`.

  Usa `webhook_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/send-webhook-test
  Guía: https://docs.veriko.mx/es/how-to/set-up-webhooks
}
