meta {
  name: Delete a webhook endpoint (destructive)
  type: http
  seq: 10
  tags: [
    destructive
  ]
}

delete {
  url: {{base_url}}/webhooks/{{webhook_id}}
  body: none
  auth: inherit
}

tests {
  test("responds with 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Deletes an endpoint.

  Destructive request. Deletes the endpoint and its whole delivery history. It cannot be undone. To keep the history, set the status to `disabled` with the update request.

  Uses `webhook_id`, saved by an earlier request. Run the requests in the order of the folder, or set the variable in the environment.

  Reference: https://docs.veriko.mx/en/v1/webhooks/delete-webhook
  Guide: https://docs.veriko.mx/en/how-to/set-up-webhooks
}
