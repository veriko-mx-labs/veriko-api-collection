meta {
  name: Crear un endpoint de webhook
  type: http
  seq: 2
}

post {
  url: {{base_url}}/webhooks
  body: json
  auth: inherit
}

body:json {
  {
    "url": "{{webhook_receiver_url}}",
    "events": [
      "validation.completed",
      "validation.failed",
      "validation.error",
      "validation.returned",
      "validation.retry.scheduled",
      "validation.retry.resolved",
      "validation.retry.exhausted"
    ],
    "description": "Ejemplo de la colección"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("webhook_id", res.body.data.id);
    bru.setVar("webhook_secret", res.body.data.attributes.secret);
  }
}

tests {
  test("crea el endpoint y devuelve el secreto una sola vez", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.data.id).to.be.a("string");
    expect(res.body.data.attributes.secret).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Registra un endpoint HTTPS que recibe los eventos a los que te suscribes.

  `url` debe resolver a una dirección pública. El `secret` de firma aparece sólo en esta respuesta y se guarda como `webhook_secret`. Las entregas lo llevan en `X-Webhook-Signature`.

  Guarda `webhook_id` y `webhook_secret`.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/create-webhook
  Guía: https://docs.veriko.mx/es/how-to/set-up-webhooks
}
