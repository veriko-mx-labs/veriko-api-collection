meta {
  name: Actualizar un endpoint de webhook (destructiva)
  type: http
  seq: 3
  tags: [
    destructive
  ]
}

put {
  url: {{base_url}}/webhooks/{{webhook_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "description": "Ejemplo de la colección (actualizado)",
    "status": "active"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Actualiza la URL, los eventos o el estado de un endpoint.

  Petición destructiva. Sólo cambian los campos que envíes. El secreto de firma sigue igual.

  Usa `webhook_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/update-webhook
  Guía: https://docs.veriko.mx/es/how-to/set-up-webhooks
}
