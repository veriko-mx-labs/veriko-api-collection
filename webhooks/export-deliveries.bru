meta {
  name: Exportar las entregas de un endpoint
  type: http
  seq: 6
}

get {
  url: {{base_url}}/webhooks/{{webhook_id}}/deliveries/export?format=csv
  body: none
  auth: inherit
}

params:query {
  format: csv
  ~limit: 1
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga hasta 100,000 registros de entregas de un endpoint en CSV o XLSX.

  Parámetros de consulta:
  - `format` (opcional): Formato del archivo.
  - `limit` (opcional): Recorta el número de filas del archivo.

  Usa `webhook_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/export-webhook-deliveries
  Guía: https://docs.veriko.mx/es/concepts/webhooks-architecture
}
