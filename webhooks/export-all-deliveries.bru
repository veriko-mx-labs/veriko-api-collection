meta {
  name: Exportar las entregas de todos los endpoints
  type: http
  seq: 8
}

get {
  url: {{base_url}}/webhooks/deliveries/export?format=csv
  body: none
  auth: inherit
}

params:query {
  format: csv
  ~endpoint_id: {{webhook_id}}
  ~status: success
  ~event_type: validation.completed
  ~q: validation.completed
  ~validation_id: {{validation_id}}
  ~response_status: 2xx
  ~from: 2026-04-01
  ~to: 2026-04-30
  ~min_attempt: 2
  ~min_response_time_ms: 1000
  ~limit: 1
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga el historial de entregas de todos los endpoints en CSV o XLSX.

  Parámetros de consulta:
  - `endpoint_id` (opcional): Filtro: identificador único del endpoint de webhook (UUID v4).
  - `status` (opcional): Estado de la entrega.
  - `event_type` (opcional): Tipo de evento que originó la entrega.
  - `q` (opcional): Busca en el identificador de la entrega, el identificador, la URL y la descripción del endpoint, el tipo de evento, el identificador de la validación y el código HTTP de la respuesta.
  - `validation_id` (opcional): Sólo las entregas de esta validación (UUID v4).
  - `response_status` (opcional): Código HTTP con el que respondió el receptor, separados por coma.
  - `from` (opcional): Entregas creadas a partir de este momento, inclusive.
  - `to` (opcional): Entregas creadas hasta este momento, inclusive.
  - `min_attempt` (opcional): Sólo las entregas cuyo número de intento sea al menos este.
  - `min_response_time_ms` (opcional): Sólo las entregas cuyo receptor tardó al menos estos milisegundos en responder.
  - `format` (opcional): Formato del archivo.
  - `limit` (opcional): Recorta el número de filas del archivo.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/export-all-deliveries
  Guía: https://docs.veriko.mx/es/concepts/webhooks-architecture
}
