meta {
  name: Regenerar el secreto de firma (destructiva)
  type: http
  seq: 9
  tags: [
    destructive
  ]
}

post {
  url: {{base_url}}/webhooks/{{webhook_id}}/regenerate-secret
  body: json
  auth: inherit
}

body:json {
  {
    "immediate": false
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("webhook_secret", res.body.data.attributes.secret);
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Rota el secreto que firma las entregas de un endpoint.

  Petición destructiva. El secreto nuevo aparece sólo en esta respuesta y se guarda como `webhook_secret`. Durante 24 horas las entregas también llevan la firma anterior en `X-Webhook-Signature-Old`; con `"immediate": true` el secreto anterior deja de servir al instante.

  Usa `webhook_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Guarda `webhook_secret`.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/regenerate-webhook-secret
  Guía: https://docs.veriko.mx/es/concepts/webhooks-architecture
}
