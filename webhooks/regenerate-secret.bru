meta {
  name: Regenerate the signing secret (destructive)
  type: http
  seq: 9
  tags: [
    destructive
  ]
}

post {
  url: {{base_url}}/webhooks/{{webhook_id}}/regenerate-secret
  body: json
  auth: inherit
}

body:json {
  {
    "immediate": false
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("webhook_secret", res.body.data.attributes.secret);
  }
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Rotates the secret that signs the deliveries of an endpoint.

  Destructive request. The new secret appears only in this response and is saved as `webhook_secret`. For 24 hours deliveries also carry the previous signature in `X-Webhook-Signature-Old`; with `"immediate": true` the previous secret stops working at once.

  Uses `webhook_id`, saved by an earlier request. Run the requests in the order of the folder, or set the variable in the environment.

  Saves `webhook_secret`.

  Reference: https://docs.veriko.mx/en/v1/webhooks/regenerate-webhook-secret
  Guide: https://docs.veriko.mx/en/concepts/webhooks-architecture
}
