settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lista los endpoints registrados con su estado y los eventos a los que se suscriben. No incluye el secreto.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/list-webhooks
  Guía: https://docs.veriko.mx/es/how-to/set-up-webhooks
