meta {
  name: List webhook endpoints
  type: http
  seq: 1
}

get {
  url: {{base_url}}/webhooks
  body: none
  auth: inherit
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lists the registered endpoints with their status and subscribed events. The secret is not included.

  Reference: https://docs.veriko.mx/en/v1/webhooks/list-webhooks
  Guide: https://docs.veriko.mx/en/how-to/set-up-webhooks
}
