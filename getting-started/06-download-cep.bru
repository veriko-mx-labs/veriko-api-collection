meta {
  name: 06 Descargar el CEP
  type: http
  seq: 6
}

get {
  url: {{base_url}}/validations/{{queued_validation_id}}/cep?format=xml
  body: none
  auth: inherit
}

params:query {
  format: xml
}

tests {
  test("devuelve el CEP, o 404 cep_not_available si el veredicto no tiene", function () {
    expect([200, 404]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.getHeader("content-type")).to.include("xml");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga como XML el CEP oficial de Banxico de la validación que sondeaste.

  Responde `404` con `cep_not_available` cuando el veredicto no tiene CEP, como pasa con los datos de ejemplo. Usa `format=pdf` para el PDF.

  Parámetros de consulta:
  - `format` (opcional): Formato del certificado: `xml` (predeterminado) o `pdf`.

  Usa `queued_validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/validations/download-cep
  Guía: https://docs.veriko.mx/es/how-to/inspect-validations
}
