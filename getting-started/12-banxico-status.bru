settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns the operational status of the Banxico validation service: `operational`, `degraded` or `down`.

  Check it before a run of synchronous validations.

  Reference: https://docs.veriko.mx/en/v1/banxico-status/banxico-public-status
}
