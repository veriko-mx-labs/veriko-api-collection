meta {
  name: 11 Listar los bancos SPEI
  type: http
  seq: 11
}

get {
  url: {{base_url}}/public/banks
  body: none
  auth: none
}

headers {
  ~If-None-Match: {{banks_etag}}
}

script:post-response {
  const etag = res.getHeader("etag");
  if (etag) {
    bru.setVar("banks_etag", etag);
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el catálogo de bancos que participan en SPEI. No necesita clave de API.

  Activa `If-None-Match` para recibir `304` cuando el catálogo no cambió.

  Guarda `banks_etag`.

  Referencia: https://docs.veriko.mx/es/v1/public/list-banks
  Guía: https://docs.veriko.mx/es/bank-directory
}
