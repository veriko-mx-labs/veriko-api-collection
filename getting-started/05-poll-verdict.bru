meta {
  name: 05 Sondear el veredicto
  type: http
  seq: 5
}

get {
  url: {{base_url}}/validations/{{queued_validation_id}}
  body: none
  auth: inherit
}

headers {
  If-None-Match: {{queued_validation_etag}}
}

script:post-response {
  const TERMINAL = ["valid", "not_found", "cep_unavailable", "invalid", "returned", "failed", "error"];
  const MAX_POLLS = 30;
  const etag = res.getHeader("etag");
  if (etag) {
    bru.setVar("queued_validation_etag", etag);
  }
  let done = false;
  let waitSeconds = Number(res.getHeader("retry-after")) || 2;
  if (res.getStatus() === 200) {
    const attributes = res.body.data.attributes;
    bru.setVar("validation_status", attributes.status);
    waitSeconds = Number(res.getHeader("retry-after")) || Number((res.body.meta || {}).next_poll_after_seconds) || 2;
    if (TERMINAL.includes(attributes.status)) {
      done = true;
    } else if (attributes.expires_at && Date.now() > Date.parse(attributes.expires_at)) {
      done = true; // la validación venció (ttl_expired); deja de sondear
    }
  } else if (res.getStatus() !== 304) {
    done = true; // 404, 422 y el resto no cambian al sondear
  }
  const polls = Number(bru.getVar("poll_count") || 0) + 1;
  bru.setVar("poll_count", String(polls));
  if (!done && polls < MAX_POLLS) {
    await bru.sleep(waitSeconds * 1000);
    bru.runner.setNextRequest("05 Sondear el veredicto");
  } else {
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("devuelve el estado actual, o 304 si nada cambió", function () {
    expect([200, 304]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.body.data.attributes.status).to.be.a("string");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Sondea `queued_validation_id` hasta que la validación llegue a un estado terminal.

  Los estados terminales son `valid`, `not_found`, `cep_unavailable`, `invalid`, `returned`, `failed` y `error`. `queued` y `processing` no son terminales.

  Respeta `Retry-After` y `meta.next_poll_after_seconds`. El script espera ese tiempo, envía el último `ETag` en `If-None-Match` y repite la petición en el ejecutor hasta 30 veces o hasta `expires_at`.

  Un envío suelto, sin el ejecutor, devuelve una sola lectura.

  Usa `queued_validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Guarda `queued_validation_etag` y `validation_status`.

  Referencia: https://docs.veriko.mx/es/v1/validations/get-validation
  Guía: https://docs.veriko.mx/es/concepts/async-validations
}
