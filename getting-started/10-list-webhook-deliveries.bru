meta {
  name: 10 List webhook deliveries
  type: http
  seq: 10
}

get {
  url: {{base_url}}/webhooks/{{webhook_id}}/deliveries?page=1&per_page=50
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 50
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lists the delivery attempts of the endpoint, including the test delivery.

  Query parameters:
  - `page` (optional): Page requested, starting at 1.
  - `per_page` (optional): How many deliveries each page carries.

  Uses `webhook_id`, saved by an earlier request. Run the requests in the order of the folder, or set the variable in the environment.

  Reference: https://docs.veriko.mx/en/v1/webhooks/list-webhook-deliveries
  Guide: https://docs.veriko.mx/en/concepts/webhooks-architecture
}
