meta {
  name: 10 Listar las entregas del webhook
  type: http
  seq: 10
}

get {
  url: {{base_url}}/webhooks/{{webhook_id}}/deliveries?page=1&per_page=50
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 50
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lista los intentos de entrega del endpoint, incluida la entrega de prueba.

  Parámetros de consulta:
  - `page` (opcional): Página que se pide, empezando en 1.
  - `per_page` (opcional): Cuántas entregas trae cada página.

  Usa `webhook_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/list-webhook-deliveries
  Guía: https://docs.veriko.mx/es/concepts/webhooks-architecture
}
