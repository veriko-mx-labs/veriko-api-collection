meta {
  name: 13 Eliminar el endpoint de webhook (destructiva)
  type: http
  seq: 13
  tags: [
    destructive
  ]
}

delete {
  url: {{base_url}}/webhooks/{{webhook_id}}
  body: none
  auth: inherit
}

tests {
  test("responde 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Elimina el endpoint que registraste en el paso 08.

  Petición destructiva. Elimina el endpoint y todo su historial de entregas. No se puede deshacer.

  Usa `webhook_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/webhooks/delete-webhook
  Guía: https://docs.veriko.mx/es/how-to/set-up-webhooks
}
