meta {
  name: 04 Poner en cola por imagen
  type: http
  seq: 4
  tags: [
    consumes-quota
  ]
}

post {
  url: {{base_url}}/validate-ocr?async=1
  body: json
  auth: inherit
}

params:query {
  async: 1
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "image_url": "{{receipt_image_url}}",
    "client_ref": "coleccion-ejemplo-ocr"
  }
}

script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("validation_id", res.body.data.id);
    bru.setVar("queued_validation_id", res.body.data.id);
    bru.setVar("queued_validation_etag", res.getHeader("etag") || "");
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("acepta la validación y devuelve su identificador", function () {
    expect([202, 422]).to.include(res.getStatus());
    if (res.getStatus() === 202) {
      expect(res.body.data.id).to.be.a("string");
      expect(res.body.data.attributes.status).to.be.oneOf(["queued", "processing"]);
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Pone en cola la validación de la imagen de un comprobante SPEI y responde `202` de inmediato, sin veredicto.

  Consume cuota. Cada validación aceptada cuenta contra el plan, y un `not_found` se cobra igual que un `valid`.

  Envía `image_url` con el valor de la variable `receipt_image_url`. Un comprobante rechazado responde `422` y aun así consume cuota.

  Sondea la validación en el paso 05.

  Parámetros de consulta:
  - `async` (opcional): Ponlo en `1` para poner en cola la validación. La respuesta es `202` con el identificador de la validación.

  Guarda `validation_id`, `queued_validation_id` y `queued_validation_etag`.

  Referencia: https://docs.veriko.mx/es/v1/validations/validate-ocr
  Guía: https://docs.veriko.mx/es/how-to/validate-ocr
}
