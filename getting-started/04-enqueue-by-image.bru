meta {
  name: 04 Enqueue by image
  type: http
  seq: 4
  tags: [
    consumes-quota
  ]
}

post {
  url: {{base_url}}/validate-ocr?async=1
  body: json
  auth: inherit
}

params:query {
  async: 1
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "image_url": "{{receipt_image_url}}",
    "client_ref": "collection-example-ocr"
  }
}

script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("validation_id", res.body.data.id);
    bru.setVar("queued_validation_id", res.body.data.id);
    bru.setVar("queued_validation_etag", res.getHeader("etag") || "");
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("accepts the validation and returns its identifier", function () {
    expect([202, 422]).to.include(res.getStatus());
    if (res.getStatus() === 202) {
      expect(res.body.data.id).to.be.a("string");
      expect(res.body.data.attributes.status).to.be.oneOf(["queued", "processing"]);
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Queues the validation of a SPEI receipt image and returns `202` at once, without a verdict.

  Consumes quota. Every accepted validation counts against the plan, and a `not_found` is billed like a `valid`.

  Sends `image_url` from the `receipt_image_url` variable. A receipt that is rejected returns `422` and still consumes quota.

  Poll the validation in step 05.

  Query parameters:
  - `async` (optional): Set to `1` to queue the validation. The response is `202` with the validation identifier.

  Saves `validation_id`, `queued_validation_id`, `queued_validation_etag`.

  Reference: https://docs.veriko.mx/en/v1/validations/validate-ocr
  Guide: https://docs.veriko.mx/en/how-to/validate-ocr
}
