meta {
  name: 01 Validar por campos
  type: http
  seq: 1
  tags: [
    consumes-quota
  ]
}

post {
  url: {{base_url}}/validate
  body: json
  auth: inherit
}

params:query {
  ~async: 1
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "send_date": "2025-03-15",
    "amount": 15000.5,
    "tracking_key": "MXBA20250315001234",
    "numeric_reference": "1234567",
    "sender_bank": "BANCO NACIONAL DE MEXICO",
    "receiver_bank": "BBVA MEXICO",
    "beneficiary_account": "012180004412345678",
    "client_ref": "coleccion-ejemplo"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("validation_id", res.body.data.id);
  } else if (res.getStatus() === 202) {
    // sync_deadline: Banxico tardó más de 45 segundos. Sondea la validación.
    bru.setVar("validation_id", res.body.data.id);
    bru.setVar("queued_validation_id", res.body.data.id);
    bru.setVar("queued_validation_etag", res.getHeader("etag") || "");
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("devuelve un veredicto, o pasa la validación a segundo plano con 202 sync_deadline", function () {
    expect([200, 202]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.body.data.attributes.status).to.be.a("string");
    } else if (res.getStatus() === 202) {
      expect(res.body.meta.async_reason).to.equal("sync_deadline");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Valida una transferencia SPEI a partir de sus campos y devuelve el veredicto en la misma respuesta.

  Consume cuota. Cada validación aceptada cuenta contra el plan, y un `not_found` se cobra igual que un `valid`.

  Una respuesta `202` con `meta.async_reason: sync_deadline` significa que Banxico tardó más de 45 segundos. La validación sigue en segundo plano; continúa con el paso 05.

  El cuerpo trae datos de ejemplo. Una transferencia que no existe devuelve `not_found`.

  Parámetros de consulta:
  - `async` (opcional): Ponlo en `1` para poner en cola la validación. La respuesta es `202` con el identificador de la validación.

  Guarda `validation_id` y `queued_validation_id` (con 202).

  Referencia: https://docs.veriko.mx/es/v1/validations/validate-direct
  Guía: https://docs.veriko.mx/es/how-to/validate-spei
}
