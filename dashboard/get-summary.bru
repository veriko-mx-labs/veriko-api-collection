meta {
  name: Consultar el resumen del panel
  type: http
  seq: 1
}

get {
  url: {{base_url}}/summary?limit=5
  body: none
  auth: inherit
}

params:query {
  limit: 5
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve los contadores agregados de la cuenta y sus validaciones más recientes.

  Parámetros de consulta:
  - `limit` (opcional): Filtro: número máximo de validaciones recientes que se devuelven.

  Referencia: https://docs.veriko.mx/es/v1/dashboard/get-dashboard-summary
}
