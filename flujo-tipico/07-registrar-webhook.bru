meta {
  name: 07 - Registrar un endpoint de webhook
  type: http
  seq: 7
}

post {
  url: {{base_url}}/webhooks
  body: json
  auth: inherit
}

body:json {
  {
    "url": "{{webhook_receiver_url}}",
    "events": ["validation.completed", "validation.failed"],
    "description": "Colección de peticiones — flujo de prueba"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("webhook_id", res.body.data.id);
  }
}

tests {
  test("responde 200 con el endpoint creado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.id).to.be.a("string");
  });
}

docs {
  Da de alta un endpoint HTTPS que recibirá los eventos suscritos.
  `url` debe resolver a una dirección pública: cambia
  `webhook_receiver_url` en el entorno por la tuya (por ejemplo, un
  endpoint temporal de https://webhook.site para probar).

  El `secret` de firma sólo aparece en esta respuesta: guárdalo para
  verificar la firma de cada entrega. El identificador queda en
  `webhook_id` para las dos peticiones siguientes.
}
