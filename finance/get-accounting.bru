meta {
  name: Exportar el archivo contable
  type: http
  seq: 2
}

get {
  url: {{base_url}}/finance/accounting?month=2026-04&format=csv
  body: none
  auth: inherit
}

params:query {
  month: 2026-04
  format: csv
  ~decimal: comma
  ~user_id: 00000000-0000-4000-8000-000000000000
  ~limit: 1
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Exporta el reporte mensual con fechas `DD/MM/YYYY` y un separador decimal configurable.

  Parámetros de consulta:
  - `month` (obligatorio): Mes a exportar en formato `YYYY-MM`.
  - `decimal` (opcional): Separador decimal.
  - `format` (opcional): Formato del archivo que se descarga.
  - `user_id` (opcional): Sólo para administradores: UUID del usuario que se consulta.
  - `limit` (opcional): Recorta el número de filas cuando la salida es `csv` o `xlsx`.

  Referencia: https://docs.veriko.mx/es/v1/finance/get-finance-accounting
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
