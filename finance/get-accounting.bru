meta {
  name: Export the accounting file
  type: http
  seq: 2
}

get {
  url: {{base_url}}/finance/accounting?month=2026-04&format=csv
  body: none
  auth: inherit
}

params:query {
  month: 2026-04
  format: csv
  ~decimal: comma
  ~user_id: 00000000-0000-4000-8000-000000000000
  ~limit: 1
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Exports the monthly report with `DD/MM/YYYY` dates and a configurable decimal separator.

  Query parameters:
  - `month` (required): Month to export in `YYYY-MM` format.
  - `decimal` (optional): Decimal separator.
  - `format` (optional): Requested file format for the download.
  - `user_id` (optional): Administrators only, UUID of the user to query.
  - `limit` (optional): Trims the number of rows when the output is `csv` or `xlsx`.

  Reference: https://docs.veriko.mx/en/v1/finance/get-finance-accounting
  Guide: https://docs.veriko.mx/en/how-to/generate-finance-report
}
