meta {
  name: Consultar el resumen mensual
  type: http
  seq: 1
}

get {
  url: {{base_url}}/finance/summary?month=2026-04
  body: none
  auth: inherit
}

params:query {
  month: 2026-04
  ~user_id: 00000000-0000-4000-8000-000000000000
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve los indicadores de un mes: conteo de veredictos, montos, tasa de éxito y desgloses.

  Parámetros de consulta:
  - `month` (obligatorio): Mes a consultar en formato `YYYY-MM`.
  - `user_id` (opcional): Sólo para administradores: UUID del usuario que se consulta.

  Referencia: https://docs.veriko.mx/es/v1/finance/get-finance-summary
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
