meta {
  name: Descargar una exportación de CEP
  type: http
  seq: 4
}

get {
  url: {{base_url}}/finance/ceps/exports/{{cep_export_id}}/download
  body: none
  auth: inherit
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga el ZIP de una exportación de CEP en estado `ready`.

  Responde `409 export_not_ready` mientras la exportación está en curso y `410` cuando el archivo ya venció.

  Usa `cep_export_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/finance/download-finance-cep-export
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
