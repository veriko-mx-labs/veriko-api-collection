meta {
  name: Solicitar una exportación de CEP
  type: http
  seq: 1
}

post {
  url: {{base_url}}/finance/ceps/exports
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "from": "2026-04-01",
    "to": "2026-04-30"
  }
}

script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("cep_export_id", res.body.data.id);
  }
}

tests {
  test("pone en cola la exportación", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.body.data.id).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Pone en cola el archivo de CEP de un rango de fechas y responde `202` de inmediato.

  Envía un `Idempotency-Key`. Sondea la exportación con `cep_export_id`.

  Guarda `cep_export_id`.

  Referencia: https://docs.veriko.mx/es/v1/finance/create-finance-cep-export
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
