meta {
  name: Sondear una exportación de CEP
  type: http
  seq: 3
}

get {
  url: {{base_url}}/finance/ceps/exports/{{cep_export_id}}
  body: none
  auth: inherit
}

script:post-response {
  const TERMINAL_EXPORT = ["ready", "failed", "expired"];
  const polls = Number(bru.getVar("cep_export_polls") || 0) + 1;
  bru.setVar("cep_export_polls", String(polls));
  const state = res.getStatus() === 200 ? res.body.data.attributes.status : "stop";
  if (state !== "stop" && !TERMINAL_EXPORT.includes(state) && polls < 30) {
    await bru.sleep(3000);
    bru.runner.setNextRequest("Sondear una exportación de CEP");
  } else {
    bru.setVar("cep_export_polls", "0");
  }
}

tests {
  test("devuelve la exportación", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.attributes.status).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el estado de una exportación de CEP y se repite en el ejecutor hasta que sea terminal.

  Los estados terminales son `ready`, `failed` y `expired`. Mientras el estado sea `queued` o `building`, el script espera 3 segundos y repite la petición, hasta 30 veces.

  Usa `cep_export_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/finance/get-finance-cep-export
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
