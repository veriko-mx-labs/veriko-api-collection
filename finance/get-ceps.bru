meta {
  name: Descargar CEP en un ZIP
  type: http
  seq: 7
}

get {
  url: {{base_url}}/finance/ceps?from=2026-04-01&to=2026-04-30
  body: none
  auth: inherit
}

params:query {
  from: 2026-04-01
  to: 2026-04-30
  ~user_id: 00000000-0000-4000-8000-000000000000
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga en un solo ZIP todos los CEP disponibles de un rango de fechas.

  Para rangos grandes usa las peticiones de exportación.

  Parámetros de consulta:
  - `from` (obligatorio): Fecha de inicio (inclusive, `YYYY-MM-DD`).
  - `to` (obligatorio): Fecha de fin (inclusive, `YYYY-MM-DD`).
  - `user_id` (opcional): Sólo para administradores: UUID del usuario que se consulta.

  Referencia: https://docs.veriko.mx/es/v1/finance/get-finance-ceps
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
