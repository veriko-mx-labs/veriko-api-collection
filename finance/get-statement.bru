meta {
  name: Consultar el estado de cuenta mensual
  type: http
  seq: 6
}

get {
  url: {{base_url}}/finance/statement?month=2026-04&format=pdf
  body: none
  auth: inherit
}

params:query {
  month: 2026-04
  format: pdf
  ~user_id: 00000000-0000-4000-8000-000000000000
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Genera el estado de cuenta mensual en PDF, XLSX, CSV o HTML.

  Parámetros de consulta:
  - `month` (obligatorio): Mes del estado de cuenta en formato `YYYY-MM`.
  - `format` (opcional): Formato del archivo que se descarga.
  - `user_id` (opcional): Sólo para administradores: UUID del usuario que se consulta.

  Referencia: https://docs.veriko.mx/es/v1/finance/get-finance-statement
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
