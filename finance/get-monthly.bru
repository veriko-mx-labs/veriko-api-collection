meta {
  name: Consultar el reporte mensual
  type: http
  seq: 5
}

get {
  url: {{base_url}}/finance/monthly?month=2026-04&format=preview
  body: none
  auth: inherit
}

params:query {
  month: 2026-04
  format: preview
  ~user_id: 00000000-0000-4000-8000-000000000000
  ~limit: 1
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve la lista mensual de verificaciones en 15 columnas.

  Parámetros de consulta:
  - `month` (obligatorio): Mes a reportar en formato `YYYY-MM`.
  - `format` (opcional): Formato del archivo que se descarga.
  - `user_id` (opcional): Sólo para administradores: UUID del usuario que se consulta.
  - `limit` (opcional): Recorta el número de filas cuando la salida es `csv` o `xlsx`.

  Referencia: https://docs.veriko.mx/es/v1/finance/get-finance-monthly
  Guía: https://docs.veriko.mx/es/how-to/generate-finance-report
}
