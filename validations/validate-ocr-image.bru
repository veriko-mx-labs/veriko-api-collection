meta {
  name: Validar por imagen (base64)
  type: http
  seq: 5
  tags: [
    consumes-quota
  ]
}

post {
  url: {{base_url}}/validate-ocr
  body: json
  auth: inherit
}

params:query {
  ~async: 1
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "image": "{{receipt_image_base64}}",
    "client_ref": "coleccion-ejemplo-ocr-image"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("validation_id", res.body.data.id);
  } else if (res.getStatus() === 202) {
    // sync_deadline: Banxico tardó más de 45 segundos. Sondea la validación.
    bru.setVar("validation_id", res.body.data.id);
    bru.setVar("queued_validation_id", res.body.data.id);
    bru.setVar("queued_validation_etag", res.getHeader("etag") || "");
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("devuelve un veredicto, pasa a segundo plano con 202 o rechaza el comprobante con 422", function () {
    expect([200, 202, 422]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Valida una transferencia SPEI a partir de un comprobante que se envía en línea, en base64, en `image`.

  Consume cuota. Cada validación aceptada cuenta contra el plan, y un `not_found` se cobra igual que un `valid`.

  Define `receipt_image_base64` en el entorno con el base64 de tu comprobante, de hasta 12 MB.

  Un comprobante que no se puede leer o que no es de SPEI responde `422` y aun así consume cuota.

  Parámetros de consulta:
  - `async` (opcional): Ponlo en `1` para poner en cola la validación. La respuesta es `202` con el identificador de la validación.

  Guarda `validation_id`.

  Referencia: https://docs.veriko.mx/es/v1/validations/validate-ocr
  Guía: https://docs.veriko.mx/es/how-to/validate-ocr
}
