meta {
  name: Validate by image (base64)
  type: http
  seq: 5
  tags: [
    consumes-quota
  ]
}

post {
  url: {{base_url}}/validate-ocr
  body: json
  auth: inherit
}

params:query {
  ~async: 1
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "image": "{{receipt_image_base64}}",
    "client_ref": "collection-example-ocr-image"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("validation_id", res.body.data.id);
  } else if (res.getStatus() === 202) {
    // sync_deadline: Banxico took longer than 45 seconds. Poll the validation.
    bru.setVar("validation_id", res.body.data.id);
    bru.setVar("queued_validation_id", res.body.data.id);
    bru.setVar("queued_validation_etag", res.getHeader("etag") || "");
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("returns a verdict, hands off with 202, or rejects the receipt with 422", function () {
    expect([200, 202, 422]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Validates a SPEI transfer from a receipt sent inline as base64 in `image`.

  Consumes quota. Every accepted validation counts against the plan, and a `not_found` is billed like a `valid`.

  Set `receipt_image_base64` in the environment to the base64 of your receipt, up to 12 MB.

  A receipt that is not readable or not a SPEI receipt returns `422` and still consumes quota.

  Query parameters:
  - `async` (optional): Set to `1` to queue the validation. The response is `202` with the validation identifier.

  Saves `validation_id`.

  Reference: https://docs.veriko.mx/en/v1/validations/validate-ocr
  Guide: https://docs.veriko.mx/en/how-to/validate-ocr
}
