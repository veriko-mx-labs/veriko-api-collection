meta {
  name: Get validation statistics
  type: http
  seq: 8
}

get {
  url: {{base_url}}/validations/stats
  body: none
  auth: inherit
}

params:query {
  ~type: direct
  ~from: 2026-04-01
  ~to: 2026-04-30
  ~search: MXBA
  ~client_ref: collection-example
  ~playground: 1
  ~with_deleted: 0
  ~batch_id: 1
  ~bank: 40012
  ~banks: 40012,40002
  ~amount_min: 1000
  ~amount_max: 50000
  ~status: example
  ~retry_state: pending
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns aggregate counters of the account validations, with the same filters as the list.

  Query parameters:
  - `type` (optional): Mode: `direct` for manual validation; `ocr` for image-based validation.
  - `from` (optional): Inclusive start date, applied to the validation creation date.
  - `to` (optional): Inclusive end date, applied to the validation creation date.
  - `search` (optional): Case-insensitive text search over the submitted, normalized, and Banxico response data.
  - `client_ref` (optional): Exact match with the `client_ref` sent when validating.
  - `playground` (optional): Keeps only playground validations.
  - `with_deleted` (optional): Scope for withdrawn records: omitted includes active and withdrawn records; `0` keeps active records only and `1`, withdrawn records only.
  - `batch_id` (optional): Identifier of the import job that generated the validations.
  - `bank` (optional): SPEI code of the sending or receiving bank in the original request.
  - `banks` (optional): Comma-separated SPEI codes (up to 50); returns the validations whose sending or receiving bank is any of them.
  - `amount_min` (optional): Inclusive minimum amount for the counted validations.
  - `amount_max` (optional): Inclusive maximum amount for the counted validations.
  - `status` (optional): Accepted for parity with `GET /v1/validations`, but it does not change any counter.
  - `retry_state` (optional): Retry cycle state: `pending`, `resolved`, `exhausted`, or `cancelled`.

  Reference: https://docs.veriko.mx/en/v1/validations/validation-stats
  Guide: https://docs.veriko.mx/en/how-to/inspect-validations
}
