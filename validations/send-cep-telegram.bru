meta {
  name: Enviar el CEP a Telegram
  type: http
  seq: 18
}

post {
  url: {{base_url}}/validations/{{validation_id}}/cep/send-telegram
  body: none
  auth: inherit
}

tests {
  test("responde 202", function () {
    expect(res.getStatus()).to.equal(202);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Inicia el envío del CEP en PDF al chat de Telegram vinculado a la cuenta.

  Responde `409` con `cep_not_available` o `telegram_not_linked` cuando falta el CEP o la vinculación.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/validations/send-cep-to-telegram
  Guía: https://docs.veriko.mx/es/how-to/inspect-validations
}
