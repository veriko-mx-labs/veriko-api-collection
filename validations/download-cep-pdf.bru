meta {
  name: Descargar el CEP (PDF)
  type: http
  seq: 12
}

get {
  url: {{base_url}}/validations/{{validation_id}}/cep?format=pdf
  body: none
  auth: inherit
}

params:query {
  format: pdf
}

tests {
  test("devuelve el CEP en PDF", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("pdf");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga como PDF el CEP oficial de Banxico de una validación `valid` o `returned`.

  Parámetros de consulta:
  - `format` (opcional): Formato del certificado: `xml` (predeterminado) o `pdf`.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/validations/download-cep
  Guía: https://docs.veriko.mx/es/how-to/inspect-validations
}
