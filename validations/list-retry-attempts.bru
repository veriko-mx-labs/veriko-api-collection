meta {
  name: Listar los intentos de reintento
  type: http
  seq: 14
}

get {
  url: {{base_url}}/validations/{{validation_id}}/retry-attempts
  body: none
  auth: inherit
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el historial cronológico de los reintentos automáticos de una validación.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/validations/list-validation-retry-attempts
  Guía: https://docs.veriko.mx/es/concepts/retry-policy
}
