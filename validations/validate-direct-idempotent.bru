meta {
  name: Validar por campos, idempotente
  type: http
  seq: 3
  tags: [
    consumes-quota
  ]
}

post {
  url: {{base_url}}/validate
  body: json
  auth: inherit
}

params:query {
  ~async: 1
}

headers {
  Idempotency-Key: {{idempotency_key}}
}

body:json {
  {
    "send_date": "2025-03-15",
    "amount": 15000.5,
    "tracking_key": "MXBA20250315001234",
    "numeric_reference": "1234567",
    "sender_bank": "BANCO NACIONAL DE MEXICO",
    "receiver_bank": "BBVA MEXICO",
    "beneficiary_account": "012180004412345678",
    "client_ref": "coleccion-ejemplo-idempotent"
  }
}

script:pre-request {
  const replay = Boolean(bru.getVar("idempotency_key"));
  if (!replay) {
    bru.setVar("idempotency_key", bru.interpolate("{{$randomUUID}}"));
  }
  bru.setVar("idempotency_replay", replay ? "yes" : "no");
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("validation_id", res.body.data.id);
  } else if (res.getStatus() === 202) {
    // sync_deadline: Banxico tardó más de 45 segundos. Sondea la validación.
    bru.setVar("validation_id", res.body.data.id);
    bru.setVar("queued_validation_id", res.body.data.id);
    bru.setVar("queued_validation_etag", res.getHeader("etag") || "");
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("repite la primera respuesta en el segundo envío", function () {
    expect([200, 202]).to.include(res.getStatus());
    if (bru.getVar("idempotency_replay") === "yes") {
      expect(res.getHeader("idempotent-replayed")).to.equal("true");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Envía la misma validación dos veces con un mismo `Idempotency-Key`. El segundo envío repite la primera respuesta.

  Consume cuota. Cada validación aceptada cuenta contra el plan, y un `not_found` se cobra igual que un `valid`.

  Envía esta petición dos veces. El primer envío crea la clave en `idempotency_key`; el segundo la reutiliza y trae `Idempotent-Replayed: true`, sin consumir cuota otra vez.

  Un cuerpo distinto con la misma clave responde `422 idempotency_key_reused`; un envío mientras corre el primero responde `409 idempotency_key_in_progress`. Las claves duran 24 horas.

  Vacía `idempotency_key` para empezar de nuevo.

  Parámetros de consulta:
  - `async` (opcional): Ponlo en `1` para poner en cola la validación. La respuesta es `202` con el identificador de la validación.

  Guarda `idempotency_key` y `validation_id`.

  Referencia: https://docs.veriko.mx/es/v1/validations/validate-direct
  Guía: https://docs.veriko.mx/es/how-to/validate-spei
}
