meta {
  name: Validate by fields, idempotent
  type: http
  seq: 3
  tags: [
    consumes-quota
  ]
}

post {
  url: {{base_url}}/validate
  body: json
  auth: inherit
}

params:query {
  ~async: 1
}

headers {
  Idempotency-Key: {{idempotency_key}}
}

body:json {
  {
    "send_date": "2025-03-15",
    "amount": 15000.5,
    "tracking_key": "MXBA20250315001234",
    "numeric_reference": "1234567",
    "sender_bank": "BANCO NACIONAL DE MEXICO",
    "receiver_bank": "BBVA MEXICO",
    "beneficiary_account": "012180004412345678",
    "client_ref": "collection-example-idempotent"
  }
}

script:pre-request {
  const replay = Boolean(bru.getVar("idempotency_key"));
  if (!replay) {
    bru.setVar("idempotency_key", bru.interpolate("{{$randomUUID}}"));
  }
  bru.setVar("idempotency_replay", replay ? "yes" : "no");
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("validation_id", res.body.data.id);
  } else if (res.getStatus() === 202) {
    // sync_deadline: Banxico took longer than 45 seconds. Poll the validation.
    bru.setVar("validation_id", res.body.data.id);
    bru.setVar("queued_validation_id", res.body.data.id);
    bru.setVar("queued_validation_etag", res.getHeader("etag") || "");
    bru.setVar("poll_count", "0");
  }
}

tests {
  test("replays the first response on the second send", function () {
    expect([200, 202]).to.include(res.getStatus());
    if (bru.getVar("idempotency_replay") === "yes") {
      expect(res.getHeader("idempotent-replayed")).to.equal("true");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Sends the same validation twice under one `Idempotency-Key`. The second send replays the first response.

  Consumes quota. Every accepted validation counts against the plan, and a `not_found` is billed like a `valid`.

  Send this request twice. The first send creates the key in `idempotency_key`; the second reuses it and carries `Idempotent-Replayed: true`, without consuming quota again.

  A different body under the same key returns `422 idempotency_key_reused`; a send while the first is running returns `409 idempotency_key_in_progress`. Keys last 24 hours.

  Clear `idempotency_key` to start over.

  Query parameters:
  - `async` (optional): Set to `1` to queue the validation. The response is `202` with the validation identifier.

  Saves `idempotency_key`, `validation_id`.

  Reference: https://docs.veriko.mx/en/v1/validations/validate-direct
  Guide: https://docs.veriko.mx/en/how-to/validate-spei
}
