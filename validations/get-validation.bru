meta {
  name: Consultar una validación
  type: http
  seq: 10
}

get {
  url: {{base_url}}/validations/{{validation_id}}
  body: none
  auth: inherit
}

headers {
  ~If-None-Match: {{validation_etag}}
}

script:post-response {
  const etag = res.getHeader("etag");
  if (etag) {
    bru.setVar("validation_etag", etag);
  }
}

tests {
  test("devuelve la validación", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data.attributes.status).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el registro completo de una validación: veredicto, datos normalizados y estado de los reintentos.

  Mientras el estado sea `queued` o `processing`, `Retry-After` y `meta.next_poll_after_seconds` indican cuándo volver a sondear. Activa `If-None-Match` para recibir `304` cuando nada cambió.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Guarda `validation_etag`.

  Referencia: https://docs.veriko.mx/es/v1/validations/get-validation
  Guía: https://docs.veriko.mx/es/concepts/async-validations
}
