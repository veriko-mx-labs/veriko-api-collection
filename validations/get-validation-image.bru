meta {
  name: Consultar la imagen del comprobante
  type: http
  seq: 13
}

get {
  url: {{base_url}}/validations/{{validation_id}}/image
  body: none
  auth: inherit
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el comprobante que se guardó de una validación por OCR.

  Responde `404 image_not_available` si no hay imagen y `410` cuando la validación se creó con `retain_image=false`.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/validations/get-validation-image
  Guía: https://docs.veriko.mx/es/how-to/inspect-validations
}
