meta {
  name: Preparar la eliminación permanente (destructiva)
  type: http
  seq: 20
  tags: [
    destructive
  ]
}

post {
  url: {{base_url}}/validations/{{validation_id}}/purge/prepare
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("purge_token", res.body.data.attributes.confirmation_token);
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Describe lo que quitaría el borrado permanente y emite el `confirmation_token`.

  Petición destructiva. Este paso no cambia nada, pero abre la purga irreversible. El token vence en 120 segundos y se guarda como `purge_token`.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Guarda `purge_token`.

  Referencia: https://docs.veriko.mx/es/v1/validations/prepare-validation-purge
  Guía: https://docs.veriko.mx/es/how-to/purge-a-validation
}
