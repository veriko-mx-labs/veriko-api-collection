meta {
  name: Cancelar los reintentos pendientes (destructiva)
  type: http
  seq: 16
  tags: [
    destructive
  ]
}

post {
  url: {{base_url}}/validations/{{validation_id}}/cancel-retries
  body: none
  auth: inherit
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Cancela el ciclo activo de reintentos automáticos de una validación.

  Petición destructiva. Termina el ciclo de reintentos con `terminal_state: cancelled`. Un ciclo que no está activo responde `422 retry_not_active`.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/validations/cancel-validation-retries
  Guía: https://docs.veriko.mx/es/concepts/retry-policy
}
