meta {
  name: Descargar el CEP (XML)
  type: http
  seq: 11
}

get {
  url: {{base_url}}/validations/{{validation_id}}/cep?format=xml
  body: none
  auth: inherit
}

params:query {
  format: xml
}

tests {
  test("devuelve el CEP en XML", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("xml");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Descarga como XML el CEP oficial de Banxico de una validación `valid` o `returned`.

  Responde `400 invalid_export_format` con un formato desconocido, `404 cep_not_available` cuando el veredicto no tiene CEP y `410` cuando la validación se purgó.

  Parámetros de consulta:
  - `format` (opcional): Formato del certificado: `xml` (predeterminado) o `pdf`.

  Usa `validation_id`, que guardó una petición anterior. Corre las peticiones en el orden de la carpeta o define la variable en el entorno.

  Referencia: https://docs.veriko.mx/es/v1/validations/download-cep
  Guía: https://docs.veriko.mx/es/how-to/inspect-validations
}
